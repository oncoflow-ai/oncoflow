FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY ml/inference/requirements.txt .
RUN pip install -v -r requirements.txt
RUN pip install fastapi uvicorn python-multipart
# Also install nnunet v1 as the adapter uses nnUNet_predict
RUN pip install nnunet

# Setup nnU-Net Environment Variables
ENV RESULTS_FOLDER=/app/weights/nnunet
ENV nnUNet_raw_data_base=/app/nnunet_raw
ENV nnUNet_preprocessed=/app/nnunet_preprocessed

RUN mkdir -p $RESULTS_FOLDER $nnUNet_raw_data_base $nnUNet_preprocessed

# Copy weights (assuming they are placed here during build)
# COPY weights/nnunet /app/weights/nnunet

# Copy application code
COPY ml/ /app/ml/

# Set env vars for the vertex entrypoint
ENV OFLOW_MODEL_NAME=nnunet
ENV OFLOW_BACKEND=local
ENV PYTHONPATH=/app
ENV AIP_HTTP_PORT=8080

EXPOSE 8080

CMD ["python", "-m", "ml.inference.vertex.main"]
